# ---------------------------------------------------------------------------
# O Pote - configuracao de ambiente
# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha a chave.
#
#   cp .env.example .env
#
# A aplicacao FUNCIONA SEM CHAVE: sem `VITE_TMDB_API_KEY` ela entra em
# "modo demonstracao" e busca em um catalogo local embutido. Para buscar o
# catalogo real de filmes, configure a chave gratuita do TMDB abaixo.
# ---------------------------------------------------------------------------

# Chave de API do TMDB (The Movie Database).
# Gratuita. Como obter:
#   1. Crie uma conta em https://www.themoviedb.org/signup
#   2. Acesse https://www.themoviedb.org/settings/api
#   3. Solicite uma chave do tipo "Developer" (aprovacao imediata)
#   4. Copie o valor do campo "API Key (v3 auth)" para a variavel abaixo
VITE_TMDB_API_KEY=

# Opcional. Idioma usado nas requisicoes ao TMDB (titulos, sinopses e generos).
# Padrao: pt-BR
VITE_TMDB_LANGUAGE=pt-BR
